{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-one-ring.invalid/schema/table.schema.json",
  "title": "tables/*.json — a serialised LookupTable (05.6)",
  "description": "Domain coverage is not expressible here; LookupTable checks it eagerly.",
  "type": "object",
  "required": ["die", "rows"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "die": {"type": "string", "enum": ["feat", "success"]},
    "comment": {"type": "string"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["match", "value"],
        "additionalProperties": false,
        "properties": {
          "match": {
            "oneOf": [
              {"type": "string", "enum": ["eye", "rune"]},
              {"type": "integer", "minimum": 1, "maximum": 10},
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {"type": "integer", "minimum": 1, "maximum": 10}
              }
            ]
          },
          "value": true
        }
      }
    }
  }
}
