{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-one-ring.invalid/schema/pack.schema.json",
  "title": "pack.json — the manifest",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
