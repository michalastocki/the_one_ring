{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-one-ring.invalid/schema/patrons.schema.json",
  "title": "patrons.json (05.8)",
  "type": "object",
  "required": ["patrons"],
  "additionalProperties": false,
  "properties": {
    "patrons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "fellowship_bonus", "benefit"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "name": {"type": "string"},
          "favoured_callings": {"$ref": "common.schema.json#/$defs/idList"},
          "fellowship_bonus": {"type": "integer"},
          "benefit": {
            "type": "object",
            "required": ["effect"],
            "properties": {"effect": {"$ref": "common.schema.json#/$defs/id"}},
            "additionalProperties": false
          },
          "agenda": {"type": "string"}
        }
      }
    }
  }
}
